generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String               @id @default(cuid())
  name                         String?
  email                        String               @unique
  emailVerified                DateTime?
  image                        String?
  password                     String?
  plan                         Plan                 @default(UNSUBSCRIBED)
  role                         Role                 @default(USER)
  stripeCustomerId             String?              @unique
  subscriptionId               String?              @unique
  subscriptionEndsAt           DateTime?
  subscriptionStatus           SubscriptionStatus   @default(NONE)
  planInterval                 String?
  accounts                     Account[]
  sessions                     Session[]
  resumes                      Resume[]
  coverLetters                 CoverLetter[]
  applications                 Application[]
  marketingConsent             Boolean              @default(false)
  ageVerified                  Boolean              @default(false)
  emailOptOut                  Boolean              @default(false)
  renewalReminderSentAt        DateTime?
  deletedAt                    DateTime?
  auditLogs                    AuditLog[]
  referralCode                 String?              @unique
  referredBy                   String?
  referredUsers                User[]               @relation("Referrals")
  referrer                     User?                @relation("Referrals", fields: [referredBy], references: [id])
  referralRewardTier           Int                  @default(0)
  referralCycleOffset          Int                  @default(0)
  referrerConversions          ReferralConversion[] @relation("ReferrerConversions")
  referredConversions          ReferralConversion[] @relation("ReferredConversions")
  sessionVersion               Int                  @default(1)
  forceLogoutAt                DateTime? // set by admin to invalidate all active JWTs immediately
  activeSessionToken           String?              @unique
  sessionChallengeCode         String?
  sessionChallengeExp          DateTime?
  sessionChallengeAttempts     Int                  @default(0)
  sessionChallengeBlockedUntil DateTime?
  termsAcceptedAt              DateTime?
  euConsentAcceptedAt          DateTime?
  lastActiveAt                 DateTime             @default(now())
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  isManaged                    Boolean              @default(false)
  managedExpiresAt             DateTime?
  managedDownloadLimit         Int?
  managedDownloadsUsed         Int                  @default(0)
  managedCreatedBy             String?
  managedNote                  String?
  managedBlocked               Boolean              @default(false)

  consentLogs                  ConsentLog[]

  @@index([referredBy])
  @@index([deletedAt])
  @@index([plan, subscriptionStatus, subscriptionEndsAt])
  @@index([subscriptionStatus])
  @@index([plan, managedExpiresAt, managedBlocked])
  @@index([isManaged])
}

model ConsentLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String
  ipHash          String
  userAgent       String?  @db.Text
  locale          String
  consentVersion  String
  consentText     String   @db.Text
  acceptedAt      DateTime @default(now())

  @@index([userId])
  @@index([acceptedAt])
  @@index([userId, acceptedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String          @default("Mi CV")
  templateId      String          @default("classic")
  colorScheme     String          @default("#2a72d7")
  fontFamily      String          @default("Poppins")
  fontSize        Int             @default(14)
  spacing         Float           @default(1.0)
  sections        Json            @default("[]")
  personalDetails Json            @default("{}")
  photoUrl        String?         @db.Text
  photoPosition   Int             @default(15)
  thumbnailUrl    String?         @db.Text
  language        String          @default("es")
  isPublic        Boolean         @default(false)
  publicSlug      String?         @unique
  versions        ResumeVersion[]
  views           CVView[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([resumeId])
}

model CoverLetter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("Mi Carta de Presentación")
  templateId  String   @default("classic")
  content     Json     @default("{}")
  colorScheme String   @default("#2a72d7")
  fontFamily  String   @default("Poppins")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model Application {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle       String
  company        String
  status         AppStatus @default(APPLIED)
  modalidad      String?
  notes          String?   @db.Text
  url            String?
  salary         String?
  appliedAt      DateTime?
  followUpAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([followUpAt])
  @@index([userId, status])
}

model CVView {
  id       String   @id @default(cuid())
  resumeId String
  resume   Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@index([resumeId])
  @@index([viewedAt])
  @@index([resumeId, viewedAt])
}

model AIRateLimit {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([resetAt])
}

model AIUsageLog {
  id               String   @id @default(cuid())
  userId           String
  endpoint         String
  model            String   @default("")
  plan             String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([endpoint])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ReferralConversion {
  id         String   @id @default(cuid())
  referrerId String
  referredId String
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferrerConversions", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User     @relation("ReferredConversions", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
}

model StripeEvent {
  id                String   @id // Stripe event ID (e.g. evt_xxx)
  processedAt       DateTime @default(now())
  userId            String? // set when the event is associated to a known user
  checkoutSessionId String? // set for checkout.session.completed events

  @@index([processedAt])
  @@index([userId])
  @@index([checkoutSessionId])
  @@index([userId, processedAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
}

enum AuditAction {
  DELETE_ACCOUNT
  CANCEL_SUBSCRIPTION
  TOGGLE_PUBLIC_CV
  DATA_EXPORT
  REFUND_ISSUED
  PARTIAL_REFUND
  DISPUTE_CHARGEBACK
  DISPUTE_CLOSED
  DISPUTE_WON_MANUAL_REVIEW
  FRAUD_WARNING
  PROFILE_SYNCED_FROM_STRIPE
  SUBSCRIPTION_CREATED_EXTERNAL
  SUBSCRIPTION_UPDATED
  ADMIN_RECONCILE_USER
  ADMIN_FORCE_LOGOUT
  CREATE_RESUME
  EXPORT_PDF
  AI_USED
  FREE_DOWNLOAD_BLOCKED
  FREE_AI_QUOTA_EXHAUSTED
  FREE_RESUME_LIMIT_HIT
  FREE_COVER_LETTER_LIMIT_HIT
  FREE_AI_ENDPOINT_BLOCKED
  MANAGED_USER_CREATED
  MANAGED_USER_BLOCKED
  MANAGED_USER_UNBLOCKED
  MANAGED_USER_DELETED
  MANAGED_USER_EDITED
  MANAGED_USER_DOWNLOADS_RESET
  MANAGED_USER_PASSWORD_RESET
  MANAGED_DOWNLOAD_REFUND_FAILED
}

enum Role {
  USER
  SUPER_ADMIN
}

enum Plan {
  UNSUBSCRIBED
  BASIC
  SPRINT
  PRO
  LIMITED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum AppStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model PendingRegistration {
  email            String   @id
  name             String
  passwordHash     String
  marketingConsent Boolean
  ageConsent       Boolean
  referralCode     String?
  otpHash          String
  otpExp           DateTime
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
}

model PasswordReset {
  email     String    @id
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AtsCheck {
  id            String   @id @default(cuid())
  sessionId     String // anonymous session token
  scoreOverall  Int
  scoreKeywords Int
  scoreFormat   Int
  scoreSections Int
  scoreLength   Int
  scoreContact  Int      @default(0)
  locale        String
  country       String?
  userAgent     String?  @db.Text
  jdHash        String
  resumeHash    String
  ip            String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}

enum CronRunStatus {
  SUCCESS
  FAILURE
}

// Execution log for scheduled jobs (Dokploy crons). One row per authenticated run.
// Powers the admin cron-health panel: detects silent death (staleness) and failures
// so an operator can investigate root cause. Trimmed to a 90-day window by the runner.
model CronRun {
  id         String        @id @default(cuid())
  job        String // canonical key: expire-subscriptions | renewal-reminder | data-cleanup | purge-stripe-events
  status     CronRunStatus
  result     Json? // endpoint summary on success, { error } on failure
  durationMs Int?
  createdAt  DateTime      @default(now())

  @@index([job, createdAt])
  @@index([createdAt])
}

// Persisted application errors — powers the admin "Service Errors" panel.
// One row per captured failure (only real errors: 5xx / unhandled / service failures;
// expected AppError 4xx are NOT recorded). Grouped by `fingerprint` in the UI so
// similar failures collapse into one issue. userId is a plain snapshot (no FK) so
// the error history survives user deletion. Trimmed to a 30-day window by the writer.
model ErrorLog {
  id          String   @id @default(cuid())
  source      String // logger namespace: controller | cron.* | pdf | ai | stripe | auth ...
  endpoint    String? // route/operation when known
  message     String   @db.Text
  stack       String?  @db.Text
  statusCode  Int?
  userId      String? // snapshot, no relation — survives user deletion
  userEmail   String? // snapshot for display when the user is gone
  context     Json? // extra structured detail ("why")
  fingerprint String // sha1(source|endpoint|normalizedMessage) for grouping
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([fingerprint, createdAt])
  @@index([source, createdAt])
  @@index([userId, createdAt])
}
