generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  plan               Plan               @default(UNSUBSCRIBED)
  role               Role               @default(USER)
  stripeCustomerId   String?            @unique
  subscriptionId     String?            @unique
  subscriptionEndsAt DateTime?
  subscriptionStatus SubscriptionStatus @default(NONE)
  planInterval       String?
  // Language this user reads, captured at sign-up and updated whenever they switch it.
  // Null for everyone who registered before it existed — and for them the emails fall
  // back exactly as they did. Needed because a cron or a webhook has no request to read
  // Accept-Language from, so without this the renewal reminder and the referral reward
  // could not be written in the reader's language.
  preferredLocale    String?

  // Which gateway provisioned the CURRENT active plan. Existing rows are Stripe
  // (default). The internal plan state (plan/subscriptionStatus/subscriptionEndsAt)
  // stays gateway-agnostic — these IDs never mix with the Stripe ones above.
  paymentProvider              PaymentProvider?     @default(STRIPE)
  paypalSubscriptionId         String?              @unique
  paypalPlanId                 String?
  paypalOrderId                String? // one-time BASIC/SPRINT
  accounts                     Account[]
  sessions                     Session[]
  resumes                      Resume[]
  coverLetters                 CoverLetter[]
  applications                 Application[]
  marketingConsent             Boolean              @default(false)
  ageVerified                  Boolean              @default(false)
  emailOptOut                  Boolean              @default(false)
  renewalReminderSentAt        DateTime?
  deletedAt                    DateTime?
  auditLogs                    AuditLog[]
  referralCode                 String?              @unique
  referredBy                   String?
  referredUsers                User[]               @relation("Referrals")
  referrer                     User?                @relation("Referrals", fields: [referredBy], references: [id])
  referralRewardTier           Int                  @default(0)
  referralCycleOffset          Int                  @default(0)
  referrerConversions          ReferralConversion[] @relation("ReferrerConversions")
  referredConversions          ReferralConversion[] @relation("ReferredConversions")
  sessionVersion               Int                  @default(1)
  forceLogoutAt                DateTime? // set by admin to invalidate all active JWTs immediately
  activeSessionToken           String?              @unique
  sessionChallengeCode         String?
  sessionChallengeExp          DateTime?
  sessionChallengeAttempts     Int                  @default(0)
  sessionChallengeBlockedUntil DateTime?
  termsAcceptedAt              DateTime?
  euConsentAcceptedAt          DateTime?
  lastActiveAt                 DateTime             @default(now())
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  isManaged               Boolean   @default(false)
  managedExpiresAt        DateTime?
  managedDownloadLimit    Int?
  managedDownloadsUsed    Int       @default(0)
  // Admin-configurable caps for a LIMITED (managed) user. NULL = use the LIMITED
  // default (5), enforced in lib/plans.ts. Mirrors managedDownloadLimit; no effect
  // on any other plan.
  managedResumeLimit      Int?
  managedCoverLetterLimit Int?
  managedCreatedBy        String?
  managedNote             String?
  managedBlocked          Boolean   @default(false)

  consentLogs ConsentLog[]

  @@index([referredBy])
  @@index([deletedAt])
  @@index([plan, subscriptionStatus, subscriptionEndsAt])
  @@index([subscriptionStatus])
  @@index([plan, managedExpiresAt, managedBlocked])
  @@index([isManaged])
}

model ConsentLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  ipHash         String
  userAgent      String?  @db.Text
  locale         String
  consentVersion String
  consentText    String   @db.Text
  acceptedAt     DateTime @default(now())

  @@index([userId])
  @@index([acceptedAt])
  @@index([userId, acceptedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String          @default("Mi CV")
  templateId       String          @default("classic")
  colorScheme      String          @default("#2a72d7")
  fontFamily       String          @default("Poppins")
  fontSize         Int             @default(14)
  spacing          Float           @default(1.0)
  sections         Json            @default("[]")
  personalDetails  Json            @default("{}")
  photoUrl         String?         @db.Text
  photoPosition    Int             @default(15)
  thumbnailUrl     String?         @db.Text
  language         String          @default("es")
  // Source CV this one was translated FROM (null for originals). Makes translation
  // idempotent: a CV has at most one translation per target language, so repeat
  // "translate" clicks return the existing copy instead of spending another LLM call.
  translatedFromId String?
  isPublic         Boolean         @default(false)
  publicSlug       String?         @unique
  versions         ResumeVersion[]
  views            CVView[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // UNIQUE (not just index): DB-level guarantee of idempotency — a source CV can
  // have at most ONE translation per language. Two concurrent "translate" clicks
  // can never create duplicates; the second insert fails and the route returns
  // the existing copy. (Postgres treats NULLs as distinct, so originals — where
  // translatedFromId is NULL — are unaffected.)
  @@unique([translatedFromId, language])
  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([resumeId])
}

model CoverLetter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("Mi Carta de Presentación")
  templateId  String   @default("classic")
  content     Json     @default("{}")
  colorScheme String   @default("#2a72d7")
  fontFamily  String   @default("Poppins")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model Application {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle       String
  company        String
  status         AppStatus @default(APPLIED)
  modalidad      String?
  notes          String?   @db.Text
  url            String?
  salary         String?
  appliedAt      DateTime?
  followUpAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([followUpAt])
  @@index([userId, status])
}

model CVView {
  id       String   @id @default(cuid())
  resumeId String
  resume   Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@index([resumeId])
  @@index([viewedAt])
  @@index([resumeId, viewedAt])
}

model AIRateLimit {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([resetAt])
}

model AIUsageLog {
  id               String   @id @default(cuid())
  userId           String
  endpoint         String
  model            String   @default("")
  plan             String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([endpoint])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ReferralConversion {
  id         String   @id @default(cuid())
  referrerId String
  referredId String
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferrerConversions", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User     @relation("ReferredConversions", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
}

model StripeEvent {
  id                String   @id // Stripe event ID (e.g. evt_xxx)
  processedAt       DateTime @default(now())
  userId            String? // set when the event is associated to a known user
  checkoutSessionId String? // set for checkout.session.completed events

  @@index([processedAt])
  @@index([userId])
  @@index([checkoutSessionId])
  @@index([userId, processedAt])
}

/// Idempotency/dedup for PayPal webhooks — mirror of StripeEvent. PayPal delivers
/// events out of order, duplicated, and late, so every event id is processed once.
model PaypalEvent {
  id          String   @id // PayPal event id (e.g. WH-xxx)
  processedAt DateTime @default(now())
  userId      String? // set when the event maps to a known user
  resourceId  String? // subscription_id / capture_id the event refers to

  @@index([processedAt])
  @@index([userId])
}

/// Durable observability log for every Stripe webhook the app receives.
/// Separate from StripeEvent (idempotency/dedup): this records BOTH successes
/// and failures with type/status/error/latency for the admin monitoring view.
model StripeWebhookLog {
  id               String        @id @default(cuid())
  stripeEventId    String        @unique // evt_xxx — upsert increments attempts on Stripe retries
  type             String // event.type (e.g. checkout.session.completed)
  status           WebhookStatus
  errorMessage     String?       @db.Text
  errorFingerprint String? // optional link to ErrorLog.fingerprint
  latencyMs        Int?
  attempts         Int           @default(1)
  objectId         String? // id of the primary object (sub/charge/session) — NOT the full payload (PII)
  userId           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Durable observability log for every PayPal webhook the app receives — exact
/// mirror of StripeWebhookLog. Separate from PaypalEvent (idempotency/dedup): this
/// records BOTH successes and failures with type/status/error/latency for the admin
/// "PayPal Health" panel. Populated even while PayPal is disabled-in-prod, so the
/// panel is ready the moment the gateway is switched on.
model PaypalWebhookLog {
  id            String        @id @default(cuid())
  paypalEventId String        @unique // WH-xxx — upsert increments attempts on PayPal retries
  type          String // event_type (e.g. BILLING.SUBSCRIPTION.CANCELLED)
  status        WebhookStatus
  errorMessage  String?       @db.Text
  latencyMs     Int?
  attempts      Int           @default(1)
  objectId      String? // resource.id (subscription/capture id) — NOT the full payload (PII)
  userId        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([action, createdAt])
}

enum AuditAction {
  DELETE_ACCOUNT
  CANCEL_SUBSCRIPTION
  TOGGLE_PUBLIC_CV
  DATA_EXPORT
  REFUND_ISSUED
  PARTIAL_REFUND
  DISPUTE_CHARGEBACK
  DISPUTE_CLOSED
  DISPUTE_WON_MANUAL_REVIEW
  FRAUD_WARNING
  PROFILE_SYNCED_FROM_STRIPE
  SUBSCRIPTION_CREATED_EXTERNAL
  SUBSCRIPTION_UPDATED
  ADMIN_RECONCILE_USER
  ADMIN_FORCE_LOGOUT
  CREATE_RESUME
  EXPORT_PDF
  AI_USED
  FREE_DOWNLOAD_BLOCKED
  FREE_AI_QUOTA_EXHAUSTED
  FREE_RESUME_LIMIT_HIT
  FREE_COVER_LETTER_LIMIT_HIT
  FREE_AI_ENDPOINT_BLOCKED
  MANAGED_USER_CREATED
  MANAGED_USER_BLOCKED
  MANAGED_USER_UNBLOCKED
  MANAGED_USER_DELETED
  MANAGED_USER_EDITED
  MANAGED_USER_DOWNLOADS_RESET
  MANAGED_USER_PASSWORD_RESET
  MANAGED_DOWNLOAD_REFUND_FAILED
}

enum Role {
  USER
  SUPER_ADMIN
}

enum Plan {
  UNSUBSCRIBED
  BASIC
  SPRINT
  PRO
  LIMITED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum WebhookStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum AppStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model PendingRegistration {
  email            String   @id
  name             String
  passwordHash     String
  marketingConsent Boolean
  ageConsent       Boolean
  referralCode     String?
  otpHash          String
  otpExp           DateTime
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
}

model PasswordReset {
  email     String    @id
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AtsCheck {
  id            String   @id @default(cuid())
  sessionId     String // anonymous session token
  scoreOverall  Int
  scoreKeywords Int
  scoreFormat   Int
  scoreSections Int
  scoreLength   Int
  scoreContact  Int      @default(0)
  locale        String
  country       String?
  userAgent     String?  @db.Text
  jdHash        String
  resumeHash    String
  ip            String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}

enum CronRunStatus {
  SUCCESS
  FAILURE
}

// Execution log for scheduled jobs (Dokploy crons). One row per authenticated run.
// Powers the admin cron-health panel: detects silent death (staleness) and failures
// so an operator can investigate root cause. Trimmed to a 90-day window by the runner.
model CronRun {
  id         String        @id @default(cuid())
  job        String // canonical key: expire-subscriptions | renewal-reminder | data-cleanup | purge-stripe-events
  status     CronRunStatus
  result     Json? // endpoint summary on success, { error } on failure
  durationMs Int?
  createdAt  DateTime      @default(now())

  @@index([job, createdAt])
  @@index([createdAt])
}

// Decided equivalences between two skill terms — the product's own bilingual
// vocabulary, grown one verdict at a time instead of hand-listed.
//
// Why a table and not a cache: the verdict has to be the SAME every time or the
// ATS score moves without the CV changing, which is the failure this product has
// already paid for once. Measured before building it: a model asked the same 54
// pairs three times flipped one borderline verdict. Deciding a pair once and
// storing the answer removes the variance by construction — an in-memory cache
// would only hide it until the next deploy.
//
// Rows are cheap and permanent on purpose. "patient care ≡ atención al paciente"
// is not a fact about one user, so the second CV that needs it pays nothing, and
// the table becomes the dictionary no one had to write.
model SkillEquivalence {
  id String @id @default(cuid())

  // Both normalized and stored in sorted order, so (a,b) and (b,a) are one row.
  termA String
  termB String

  /// The verdict. FALSE rows matter as much as true ones: they are what stops us
  /// paying the model again to re-reject "frontend" vs "backend".
  equivalent Boolean

  /// Which model decided, so a future model change can re-decide only its own rows
  /// instead of invalidating a vocabulary that took months to accumulate.
  model     String
  createdAt DateTime @default(now())

  @@unique([termA, termB])
  @@index([createdAt])
}

// One answer to one question, kept so the same question gets the same answer.
//
// Three caches were about to exist here — the recruiter analysis, the soft-skill
// evidence pass, and the job posting's extracted keywords — with three tables,
// three purges and three chances to get the retention wrong. They are the same
// shape: a question whose answer must not change while the question does not.
//
// `kind` says which question. `inputHash` is the question itself, hashed, so two
// users asking the identical thing share one answer and the table stays small.
//
// This is what makes the score reproducible. The panel promises the number moves
// when the CV moves, and the posting side was being re-derived by a model on every
// run: the same resume scored 80, then 71, with soft skills falling from 100% to
// 80%, because the requirements it was scored against had been re-extracted and
// come back slightly different. Nothing the user did explained it, and a number
// that moves on its own is a number nobody believes.
model AiAnswerCache {
  id String @id @default(cuid())

  /// Which question: "analysis" | "soft-evidence" | "job-keywords".
  kind String

  /// sha256 of everything the answer depends on, model included.
  inputHash String

  /// The answer as it was served, AFTER every guard.
  payload Json

  model     String
  createdAt DateTime @default(now())

  /// Which résumé this answer was computed FROM.
  ///
  /// The row is addressed by content — that is what makes the same question give
  /// the same answer — but the payload is derived from one candidate's document:
  /// it quotes their bullets and describes their fit. When they delete the CV,
  /// this has to go with it, and a content hash cannot be searched by owner.
  ///
  /// Nullable so existing rows stay valid, and NOT a foreign key: the cache must
  /// never be able to block a deletion. Cleanup is explicit, in ResumeService.
  resumeId String?

  @@unique([kind, inputHash])
  @@index([createdAt])
  @@index([resumeId])
}

// Persisted application errors — powers the admin "Service Errors" panel.
// One row per captured failure (only real errors: 5xx / unhandled / service failures;
// expected AppError 4xx are NOT recorded). Grouped by `fingerprint` in the UI so
// similar failures collapse into one issue. userId is a plain snapshot (no FK) so
// the error history survives user deletion. Trimmed to a 30-day window by the writer.
model ErrorLog {
  id          String   @id @default(cuid())
  source      String // logger namespace: controller | cron.* | pdf | ai | stripe | auth ...
  endpoint    String? // route/operation when known
  message     String   @db.Text
  stack       String?  @db.Text
  statusCode  Int?
  userId      String? // snapshot, no relation — survives user deletion
  userEmail   String? // snapshot for display when the user is gone
  context     Json? // extra structured detail ("why")
  fingerprint String // sha1(source|endpoint|normalizedMessage) for grouping
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([fingerprint, createdAt])
  @@index([source, createdAt])
  @@index([userId, createdAt])
}

/// Consumo mensual de Resend, tomado de SUS cabeceras, no contado por nosotros.
///
/// Resend no expone endpoint para consultar el consumo, pero devuelve
/// `x-resend-monthly-quota` ("Your used monthly email sending quota") en cada respuesta.
/// Guardamos su número, así que no puede desviarse del que decide si hay que pagar.
///
/// `x-resend-daily-quota` SOLO llega a cuentas del plan gratuito: si `dailyRaw` viene
/// vacío es que la cuenta ya dejó de ser gratis. Por eso se guarda aunque no se muestre.
///
/// Una fila por mes (`period` = "YYYY-MM"): el histórico es lo que dice si el consumo
/// crece hacia el tope o se quedó plano, que es la decisión de compra real.
model EmailQuota {
  id String @id @default(cuid())

  /// "YYYY-MM" en UTC. Único: cada mes se actualiza su propia fila.
  period String @unique

  /// Valor crudo de la cabecera. Se guarda tal cual porque el formato NO está
  /// documentado: si algún día llega "12/3000" o un porcentaje, el dato no se pierde
  /// aunque el parseo falle, y el panel puede mostrarlo sin cambiar el esquema.
  monthlyRaw String
  dailyRaw   String?

  /// Parseo best-effort del crudo. Null = llegó en un formato que no supimos leer.
  monthlyUsed  Int?
  monthlyLimit Int?

  /// Cuántas respuestas de Resend alimentaron esta fila. Sirve de contraste: si nuestro
  /// conteo y el suyo se separan mucho, alguien más está enviando con la misma clave.
  observations Int @default(0)

  /// Última vez que Resend nos contestó con una cabecera de cuota.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
