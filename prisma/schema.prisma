generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  plan                Plan                 @default(UNSUBSCRIBED)
  trialEndsAt         DateTime?
  role                Role                 @default(USER)
  stripeCustomerId    String?              @unique
  subscriptionId      String?              @unique
  subscriptionEndsAt  DateTime?
  subscriptionStatus  SubscriptionStatus   @default(NONE)
  planInterval        String?
  accounts            Account[]
  sessions            Session[]
  resumes             Resume[]
  coverLetters        CoverLetter[]
  applications        Application[]
  marketingConsent    Boolean              @default(false)
  ageVerified         Boolean              @default(false)
  emailOptOut             Boolean              @default(false)
  renewalReminderSentAt   DateTime?
  deletedAt           DateTime?
  auditLogs           AuditLog[]
  referralCode        String?              @unique
  referredBy          String?
  referredUsers       User[]               @relation("Referrals")
  referrer            User?                @relation("Referrals", fields: [referredBy], references: [id])
  referralRewardTier  Int                  @default(0)
  referralCycleOffset Int                  @default(0)
  referrerConversions ReferralConversion[] @relation("ReferrerConversions")
  referredConversions ReferralConversion[] @relation("ReferredConversions")
  sessionVersion      Int                  @default(1)
  forceLogoutAt       DateTime?            // set by admin to invalidate all active JWTs immediately
  activeSessionToken           String?   @unique
  sessionChallengeCode         String?
  sessionChallengeExp          DateTime?
  sessionChallengeAttempts     Int       @default(0)
  sessionChallengeBlockedUntil DateTime?
  termsAcceptedAt     DateTime?
  lastActiveAt        DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([referredBy])
  @@index([deletedAt])
  @@index([plan, subscriptionStatus, subscriptionEndsAt])
  @@index([subscriptionStatus])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String          @default("Mi CV")
  templateId      String          @default("classic")
  colorScheme     String          @default("#2a72d7")
  fontFamily      String          @default("Poppins")
  fontSize        Int             @default(14)
  spacing         Float           @default(1.0)
  sections        Json            @default("[]")
  personalDetails Json            @default("{}")
  photoUrl        String?         @db.Text
  photoPosition   Int             @default(15)
  thumbnailUrl    String?         @db.Text
  language        String          @default("es")
  isPublic        Boolean         @default(false)
  publicSlug      String?         @unique
  versions        ResumeVersion[]
  views           CVView[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([resumeId])
}

model CoverLetter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("Mi Carta de Presentación")
  templateId  String   @default("classic")
  content     Json     @default("{}")
  colorScheme String   @default("#2a72d7")
  fontFamily  String   @default("Poppins")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Application {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle       String
  company        String
  status         AppStatus @default(APPLIED)
  modalidad      String?
  notes          String?   @db.Text
  url            String?
  salary         String?
  appliedAt      DateTime?
  followUpAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([followUpAt])
}

model CVView {
  id       String   @id @default(cuid())
  resumeId String
  resume   Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@index([resumeId])
  @@index([viewedAt])
}

model AIRateLimit {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([resetAt])
}

model AIUsageLog {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([endpoint])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ReferralConversion {
  id         String   @id @default(cuid())
  referrerId String
  referredId String
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferrerConversions", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User     @relation("ReferredConversions", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
}

model StripeEvent {
  id                String   @id // Stripe event ID (e.g. evt_xxx)
  processedAt       DateTime @default(now())
  userId            String?  // set when the event is associated to a known user
  checkoutSessionId String?  // set for checkout.session.completed events

  @@index([processedAt])
  @@index([userId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId])
}

enum AuditAction {
  DELETE_ACCOUNT
  CANCEL_SUBSCRIPTION
  TOGGLE_PUBLIC_CV
  DATA_EXPORT
  REFUND_ISSUED
  PARTIAL_REFUND
  DISPUTE_CHARGEBACK
  DISPUTE_CLOSED
  DISPUTE_WON_MANUAL_REVIEW
  FRAUD_WARNING
  PROFILE_SYNCED_FROM_STRIPE
  SUBSCRIPTION_CREATED_EXTERNAL
  SUBSCRIPTION_UPDATED
  ADMIN_RECONCILE_USER
  ADMIN_FORCE_LOGOUT
}

enum Role {
  USER
  SUPER_ADMIN
}

enum Plan {
  UNSUBSCRIBED
  PRO
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum AppStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model PendingRegistration {
  email            String   @id
  name             String
  passwordHash     String
  marketingConsent Boolean
  ageConsent       Boolean
  referralCode     String?
  otpHash          String
  otpExp           DateTime
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
}

model PasswordReset {
  email     String    @id
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
