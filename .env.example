# ── Base de datos ──────────────────────────────────────────────────────────
# En Dokploy usa el host interno del servicio Postgres (nombre del servicio)
DATABASE_URL="postgresql://cvvpro:cvvpro_secret@postgres:5432/cvvpro"

# ── NextAuth v5 ────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET="CAMBIA_ESTO_openssl_rand_base64_32"
AUTH_URL="https://tudominio.com"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://tudominio.com"

# ── Google OAuth ───────────────────────────────────────────────────────────
# En Google Console agrega: https://tudominio.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe ─────────────────────────────────────────────────────────────────
# Claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Webhook secret: Dashboard > Developers > Webhooks > tu endpoint > Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs: Dashboard > Products > tu producto > precio
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_ANNUAL="price_..."

# ── OpenAI (IA features) ───────────────────────────────────────────────────────
# API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ── Resend (emails) ────────────────────────────────────────────────────────────
# API key en: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# ── Cron jobs ──────────────────────────────────────────────────────────────────
CRON_SECRET="genera_con_openssl_rand_base64_32"

# ── Analytics (Microsoft Clarity — heatmaps gratuitos, privacy-first) ─────
# Project ID en: https://clarity.microsoft.com/ (deja vacío para deshabilitar)
NEXT_PUBLIC_CLARITY_ID=""

# ── PayPal (segunda pasarela, junto a Stripe) ──────────────
# Sandbox: developer.paypal.com → Apps & Credentials → Create App
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# ID del webhook registrado (developer.paypal.com → App → Webhooks)
PAYPAL_WEBHOOK_ID=
# sandbox | live
PAYPAL_ENV=sandbox
# Plan IDs SOLO para PRO recurrente ($15/mo, $99/yr). BASIC/SPRINT son pago
# unico (Orders) y NO usan estos. Se llenan tras crear los Plans (script F1.5).
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=
